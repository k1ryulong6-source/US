# Copy to .env.local and fill in from Supabase → Project Settings → API.
# If you route Supabase through the Cloudflare Worker proxy (recommended when
# members are in mainland China), put the proxy URL here instead.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Optional: weekly reminder via Web Push. Generate a pair with
#   npx web-push generate-vapid-keys
# Put the public key here, and both keys into the Edge Function secrets.
# Leave empty to hide the reminder setting entirely.
VITE_VAPID_PUBLIC_KEY=
